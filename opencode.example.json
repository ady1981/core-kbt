{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "custom",
      "options": {
        "baseURL": "{env:OPENCODE_LLM_BASE_URL}",
        "apiKey": "{env:OPENCODE_LLM_API_KEY}"
      },
      "models": {
        "{env:OPENCODE_LLM_MODEL}": {
          "name": "{env:OPENCODE_LLM_MODEL}"
        }
      }
    }
  },
  "permission": {
    "websearch": "allow"
  }  
}